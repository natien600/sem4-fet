<!DOCTYPE html>
<html>
<head>
    <title>Pull-down Menu and List Box</title>
</head>
<body>

    <h2>Pull-down Menu Example</h2>
    <select id="menu">
        <option value="">Select a Course</option>
        <option value="HTML">HTML</option>
        <option value="CSS">CSS</option>
        <option value="JavaScript">JavaScript</option>
    </select>

    <p id="output1"></p>

    <h2>List Box Example</h2>
    <select id="listbox" size="4">
        <option value="Apple">Apple</option>
        <option value="Banana">Banana</option>
        <option value="Mango">Mango</option>
        <option value="Orange">Orange</option>
    </select>

    <p id="output2"></p>

    <script>
        // Event Listener for Pull-down Menu
        document.getElementById("menu").addEventListener("change", function() {
            document.getElementById("output1").innerHTML =
                "You selected: " + this.value;
        });

        // Event Handler for List Box
        document.getElementById("listbox").onchange = function() {
            document.getElementById("output2").innerHTML =
                "You selected: " + this.value;
        };
    </script>

</body>
</html>
